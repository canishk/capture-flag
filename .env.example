# Application
APP_NAME=CipherForge
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://cipherforge:cipherforge@localhost:5432/cipherforge

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth
EMAIL_VERIFICATION_REQUIRED=false
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Storage
STORAGE_PATH=./storage
MAX_AVATAR_SIZE_BYTES=2097152
